# https://cjerrington.codeberg.page/eleventy-base-blog-site/blog/codebergpagesbuild/
#
# This file would typically be .woodpecker.yml in the root of your repository.
#
#
# SECRETS
# https://woodpecker-ci.org/docs/usage/secrets
# CBTOKEN needs a codeberg access token as secret in woodpecker config
# CBMAIL with email address for git config
# SOURCEREPO must be replaced with the source repo
# DESTREPO must be replaced with the target codeberg pages repo
# CBUSERNAME must be replaced with the user/org
#
#
# We also assume a domains file in the source repo that gets copied to
# .domains in the target repo so codeberg pages works for custom domains
#

steps:
    - name: install
      when:
          - event: push
            branch: develop
          - event: manual
            branch: develop
      image: node:alpine
      commands:
          - apk add --no-cache openjdk21-jre python3 zlib zlib-dev git
          - npm i -g pnpm
          - pnpm i --frozen-lockfile
    - name: compile-desktop
      when:
          - event: push
            branch: develop
          - event: manual
            branch: develop
      image: node:alpine
      commands:
          - npm i -g pnpm
          - cd packages/desktop
          # Don't specify CBP build mode since redirects aren't properly implemented in canary
          - NODE_ENV=production BUILD_MODE=canary ESBUILD_WORKERS=8 pnpm run webpack:compile
          # Only needed for custom domains
          # - cp domains build/.domains
    - name: production
      image: node:alpine
      when:
          - event: push
            branch: develop
          - event: manual
            branch: develop
      commands:
          - npm i -g pnpm
          - cd packages/desktop
          - pnpm run webpack:prod
    - name: publish
      when:
          - event: push
            branch: develop
          - event: manual
            branch: develop
      image: woodpeckerci/plugin-release
      settings:
          prerelease: true
          files:
              - "AmpMod-Desktop-*"
          api_key:
              from_secret: cbtoken
